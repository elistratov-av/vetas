{
    "name": "vetas/pets",
    "type": "project",
    "description": "B2B platform",
    "license": "proprietary",
    "minimum-stability": "dev",
    "prefer-stable": true,
    "require": {
        "php": "^7.2",
        "ext-json": "*",
        "bower-asset/bootstrap-multiselect": "^0.9.15",
        "bower-asset/jquery-sticky-table-headers": "^0.1.24",
        "bupy7/xml-constructor": "*",
        "cboden/ratchet": "^0.4.3",
        "dmstr/yii2-adminlte-asset": "^2.6",
        "enyo/dropzone": "^5.5",
        "guzzlehttp/guzzle": "^6.0",
        "kartik-v/yii2-date-range": "dev-master",
        "kartik-v/yii2-grid": "^3.2",
        "kartik-v/yii2-krajee-base": "dev-master",
        "kartik-v/yii2-mpdf": "dev-master",
        "kartik-v/yii2-widget-select2": "@dev",
        "lcobucci/jwt": "3.3.3",
        "linslin/yii2-curl": "1.5.0",
        "mikemadisonweb/yii2-rabbitmq": "^2.2.0",
        "miloschuman/yii2-highcharts-widget": "^7.0",
        "mpdf/mpdf": "v7.1.8",
        "php-amqplib/php-amqplib": "^2.10",
        "phpoffice/phpspreadsheet": "^1.15",
        "phpoffice/phpword": "^1.3",
        "ramsey/uuid": "^3.8",
        "ratchet/pawl": "^0.3.5",
        "samdark/yii2-minimal": "2.0.3",
        "subdee/yii2-soap-server": "dev-master",
        "textalk/websocket": "1.0.*",
        "tkutsaeva/yii2-multi-select": "dev-master",
        "tuyakhov/yii2-json-api": "v0.1.6",
        "vearutop/php-obscene-censor-rus": "^1.0",
        "vlucas/phpdotenv": "^5.3",
        "yiisoft/yii2": "2.0.15.1",
        "yiisoft/yii2-authclient": "^2.2",
        "yiisoft/yii2-bootstrap": "^2.0.10",
        "yiisoft/yii2-debug": "^2.0",
        "yiisoft/yii2-jui": "~2.0.0",
        "yiisoft/yii2-queue": "^2.1",
        "yiisoft/yii2-swiftmailer": "*",
        "yiister/yii2-adminlte": "~1.0"
    },
    "require-dev": {
        "codeception/base": "^2.2.3",
        "codeception/specify": "~0.4.3",
        "codeception/verify": "~0.3.1",
        "flow/jsonpath": "^0.4.0",
        "justinrainbow/json-schema": "^5.2",
        "yiisoft/yii2-faker": "~2.0.0",
        "yiisoft/yii2-gii": "^2.0"
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "process-timeout": 1800,
        "allow-plugins": {
            "yiisoft/yii2-composer": true
        }
    },
    "repositories": [
        {
            "type": "composer",
            "url": "http://repo-mirror.mos.ru/repository/composer-public/"
        },
        {
            "name": "subdee/yii2-soap-server",
            "type": "vcs",
            "url": "git@github.mos.ru:ZyxWs/yii2-soap-server.git"
        },
        {
            "name": "kartik-v/yii2-mpdf",
            "type": "vcs",
            "url": "git@github.mos.ru:ZyxWs/yii2-mpdf.git"
        },
        {
            "name": "tkutsaeva/yii2-multi-select",
            "type": "vcs",
            "url": "git@github.mos.ru:TKutsaeva/iripvanwinkle-yii2-multi-select.git"
        }
    ]
}
